<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Inactivity Switch Section -->
    <Switch
        android:id="@+id/inactivitySwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inactivitySwitchLabel"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/guideline50" />

    <!-- Inactivity Input Label -->
    <TextView
        android:id="@+id/inactivityInputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inactivityInputLabel"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/inactivitySwitch"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- Inactivity Time Input EditText -->
    <EditText
        android:id="@+id/inactivityTimeInput"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="@string/inactivityHint"
        android:enabled="false"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/inactivitySwitch"
        app:layout_constraintLeft_toRightOf="@+id/inactivityInputLabel" />

    <!-- Vertical Spacer -->
    <View
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/inactivityTimeInput"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/WelcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/WelcomeText"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Battery Optimization Text -->
    <TextView
        android:id="@+id/batteryOptimizationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/batteryOptimizationText"
        android:textAlignment="center"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spacer" />

    <!-- Battery Optimization Button -->
    <Button
        android:id="@+id/batteryOptimizationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/batteryOptimizationButton"
        android:onClick="disableBatteryOptimization"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/batteryOptimizationText" />

</androidx.constraintlayout.widget.ConstraintLayout>
