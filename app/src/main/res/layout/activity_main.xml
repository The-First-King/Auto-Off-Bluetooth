<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    
    <!-- Toggle App Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/toggle_app"
            android:textSize="18sp"
            android:textColor="@android:color/black" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/master_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.AppCompat.Light" />
    </LinearLayout>

    <!-- Inactivity Switcher Header Container -->
    <LinearLayout
        android:id="@+id/inactivityHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Inactivity Switcher Label -->
        <TextView
            android:id="@+id/inactivityLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inactivitySwitchLabel"
            android:textSize="16sp" />

        <!-- Inactivity Switch Toggle Button -->
        <Switch
            android:id="@+id/inactivitySwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/SwitchTheme"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Inactivity Input Container -->
    <LinearLayout
        android:id="@+id/inactivityContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/inactivityHeaderContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Inactivity Input Label -->
        <TextView
            android:id="@+id/inactivityInputLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inactivityInputLabel"
            android:textSize="16sp" />

        <!-- Inactivity Time Input EditText -->
        <EditText
            android:id="@+id/inactivityTimeInput"
            android:layout_width="80dp"
            android:layout_height="38dp"
            android:inputType="number"
            android:hint="@string/inactivityHint"
            android:textAlignment="center"
            android:enabled="false"
            android:background="@drawable/edittext_border"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Vertical Spacer -->
    <View
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/inactivityContainer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/WelcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/WelcomeText"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Battery Optimization Text -->
    <TextView
        android:id="@+id/batteryOptimizationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/batteryOptimizationText"
        android:textAlignment="center"
        android:padding="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spacer" />

    <!-- Battery Optimization Button -->
    <Button
        android:id="@+id/batteryOptimizationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/batteryOptimizationButton"
        android:onClick="disableBatteryOptimization"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/batteryOptimizationText" />

</androidx.constraintlayout.widget.ConstraintLayout>
