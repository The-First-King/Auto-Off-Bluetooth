<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme overlay for the master switch in the green app bar.
         On a colorPrimary background the normal green active color is invisible,
         so this switch uses white when ON; the Dark overlay parent keeps the
         OFF state light enough to read on green. -->
    <style name="MasterSwitchTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorControlActivated">@color/white</item>
    </style>

    <!-- Green Switch Theme -->
    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorSwitchThumbNormal">@color/colorPrimary</item>
    </style>

</resources>
